{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-parent-guardian-person.json",
  "description": "LIBRA Parent/Guardian (Individual)",
  "type": "object",
  "properties": {
    "dateOfBirth": {
      "$ref": "libra-date.json"
    },
    "gender": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "selfDefinedEthnicity": {
      "type": "string",
      "maxLength": 2
    },
    "personalInformation": {
      "$ref": "libra-parent-guardian-personal-information.json"
    }
  },
  "required": [
    "gender",
    "personalInformation"
  ],
  "additionalProperties": false
}
