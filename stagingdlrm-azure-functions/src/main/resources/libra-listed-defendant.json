{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-listed-defendant.json",
  "description": "LIBRA Listed Defendant (hearing-level defendant/offence reference)",
  "type": "object",
  "properties": {
    "prosecutorDefendantId": {
      "type": "string",
      "maxLength": 36
    },
    "listedOffences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "maxLength": 36
      }
    }
  },
  "required": [
    "listedOffences",
    "prosecutorDefendantId"
  ]
}
