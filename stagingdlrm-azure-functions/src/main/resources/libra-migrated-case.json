{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-migrated-case.json",
  "type": "object",
  "description": "LIBRA Migrated Case File Details (Function App gate)",
  "properties": {
    "caseDetails": {
      "$ref": "libra-case-details.json"
    },
    "defendants": {
      "type": "array",
      "items": {
        "$ref": "libra-defendant.json"
      }
    },
    "hearings": {
      "type": "array",
      "items": {
        "$ref": "libra-hearing.json"
      }
    },
    "officerInCase": {
      "$ref": "libra-officer-in-case.json"
    }
  },
  "required": [
    "caseDetails",
    "defendants"
  ],
  "additionalProperties": false
}