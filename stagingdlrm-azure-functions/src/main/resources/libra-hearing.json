{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-hearing.json",
  "description": "LIBRA Hearing",
  "type": "object",
  "properties": {
    "courtHearingLocation": {
      "type": "string",
      "maxLength": 7,
      "minLength": 7
    },
    "dateOfHearing": {
      "$ref": "libra-date.json"
    },
    "timeOfHearing": {
      "type": "string",
      "minLength": 8,
      "maxLength": 8,
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "hearingType": {
      "type": "string"
    },
    "listedDefendants": {
      "type": "array",
      "items": {
        "$ref": "libra-listed-defendant.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "courtHearingLocation",
    "dateOfHearing",
    "hearingType",
    "listedDefendants",
    "timeOfHearing"
  ]
}
