{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-parent-guardian-personal-information.json",
  "description": "LIBRA Parent/Guardian Personal Information",
  "type": "object",
  "properties": {
    "forename": {
      "type": "string",
      "maxLength": 35
    },
    "middleName": {
      "type": "string",
      "maxLength": 35
    },
    "middleName2": {
      "type": "string",
      "maxLength": 35
    },
    "surname": {
      "type": "string",
      "maxLength": 35
    },
    "observedEthnicity": {
      "type": "string"
    },
    "contactDetails": {
      "$ref": "libra-parent-guardian-contact-details.json"
    },
    "address": {
      "$ref": "libra-parent-guardian-address.json"
    }
  },
  "required": [
    "address",
    "surname"
  ]
}
