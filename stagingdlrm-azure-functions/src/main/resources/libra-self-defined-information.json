{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-self-defined-information.json",
  "description": "LIBRA Self-Defined Information",
  "type": "object",
  "properties": {
    "nationality": {
      "type": "string",
      "maxLength": 3
    },
    "additionalNationality": {
      "type": "string",
      "maxLength": 3
    },
    "dateOfBirth": {
      "$ref": "libra-date.json"
    },
    "gender": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "ethnicity": {
      "type": "string",
      "maxLength": 2
    }
  },
  "additionalProperties": false
}
