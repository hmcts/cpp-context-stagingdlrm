{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "libra-individual.json",
  "description": "LIBRA Individual Defendant Details",
  "type": "object",
  "properties": {
    "custodyStatus": {
      "type": "string",
      "maxLength": 1
    },
    "bailConditions": {
      "type": "string",
      "maxLength": 2500
    },
    "personalInformation": {
      "$ref": "libra-personal-information.json"
    },
    "selfDefinedInformation": {
      "$ref": "libra-self-defined-information.json"
    },
    "parentGuardianInformation": {
      "oneOf": [
        {
          "$ref": "libra-parent-guardian-person.json"
        },
        {
          "$ref": "libra-parent-guardian-organisation.json"
        }
      ]
    }
  },
  "required": [
    "personalInformation"
  ]
}
