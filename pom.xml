<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>uk.gov.moj.cpp.common</groupId>
        <artifactId>service-parent-pom</artifactId>
        <version>17.103.5</version>
    </parent>

    <groupId>uk.gov.moj.cpp.stagingdlrm</groupId>
    <artifactId>stagingdlrm-parent</artifactId>
    <version>17.103.41-PEG-2848-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>stagingdlrm Context - Parent Module</name>

    <properties>
        <jgitflow.maven.developBranchName>main</jgitflow.maven.developBranchName>
        <sonar.jacoco.itReportPath>${project.basedir}/../target/jacoco-it.exec
        </sonar.jacoco.itReportPath>
        <sonar.report.export.path>sonar-report.json</sonar.report.export.path>
        <sonar.scm.provider>git</sonar.scm.provider>
        <sonar.coverage.exclusions>
            **/uk/gov/moj/cpp/stagingdlrm/azure/event/*,
            **/uk/gov/moj/cpp/stagingdlrm/azure/exception/*,
            **/uk/gov/moj/cpp/stagingdlrm/azure/storage/*,
            **/uk/gov/moj/cpp/stagingdlrm/domain/**/*
            **/uk/gov/moj/cpp/stagingdlrm/event/processor/ObjectBuilder.java
            **/uk/gov/moj/cpp/stagingdlrm/command/api/util/JsonUtil.java
        </sonar.coverage.exclusions>
        <mvn.site.url>file://${project.build.directory}/site</mvn.site.url>
        <dbunit-maven-plugin.version>1.0-beta-3</dbunit-maven-plugin.version>
        <jmeter-maven-plugin.version>1.10.1</jmeter-maven-plugin.version>
        <jmeter-plugins-standard.version>1.3.1</jmeter-plugins-standard.version>
        <jmeter-lightning-maven-plugin>0.1.1</jmeter-lightning-maven-plugin>
        <stream-transformation-tool-api.version>7.0.0</stream-transformation-tool-api.version>
        <coredomain.version>17.103.13</coredomain.version>
        <pcfdlrm.version>17.103.23</pcfdlrm.version>
    </properties>

    <modules>
        <module>stagingdlrm-domain</module>
        <module>stagingdlrm-command</module>
        <module>stagingdlrm-event</module>
        <module>stagingdlrm-query</module>
        <module>stagingdlrm-viewstore</module>
        <module>stagingdlrm-integration-test</module>
        <module>stagingdlrm-performance-test</module>
        <module>stagingdlrm-service</module>
        <module>stagingdlrm-datatypes-common</module>
        <module>stagingdlrm-event-sources</module>
        <module>stagingdlrm-healthchecks</module>
        <module>stagingdlrm-azure-functions</module>
        <module>stagingdlrm-testharness</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>uk.gov.justice</groupId>
                <artifactId>stream-transformation-tool-anonymise</artifactId>
                <version>${stream-transformation-tool-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-war-plugin</artifactId>
                    <configuration>
                        <archiveClasses>true</archiveClasses>
                        <attachClasses>true</attachClasses>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>dbunit-maven-plugin</artifactId>
                    <version>${dbunit-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.dbunit</groupId>
                            <artifactId>dbunit</artifactId>
                            <version>${dbunit.version}</version>
                        </dependency>
                        <dependency>
                            <groupId>org.postgresql</groupId>
                            <artifactId>postgresql</artifactId>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>com.lazerycode.jmeter</groupId>
                    <artifactId>jmeter-maven-plugin</artifactId>
                    <version>${jmeter-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>kg.apc</groupId>
                            <artifactId>jmeter-plugins-standard</artifactId>
                            <version>${jmeter-plugins-standard.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <plugin>
                    <groupId>uk.co.automatictester</groupId>
                    <artifactId>jmeter-lightning-maven-plugin</artifactId>
                    <version>${jmeter-lightning-maven-plugin}</version>
                </plugin>
                <plugin>
                    <groupId>org.liquibase</groupId>
                    <artifactId>liquibase-maven-plugin</artifactId>
                    <dependencies>
                        <dependency>
                            <groupId>org.liquibase</groupId>
                            <artifactId>liquibase-core</artifactId>
                            <version>${liquibase.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <distributionManagement>
        <site>
            <id>site</id>
            <url>${mvn.site.url}</url>
        </site>
    </distributionManagement>
</project>
