{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/personal-information.json",
  "type": "object",
  "description": "Personal Information",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title by which a person is addressed",
      "maxLength": 35
    },
    "forename": {
      "type": "string",
      "description": "The first given name of a person, e.g. John ",
      "maxLength": 255
    },
    "surname": {
      "type": "string",
      "description": "Surname or Family name, e.g. Brown.",
      "maxLength": 255
    },
    "middleName": {
      "type": "string",
      "description": "Middle name, e.g. Walter.",
      "maxLength": 255
    },
    "middleName2": {
      "type": "string",
      "description": "Second middle name. Combined with middleName when forwarded to pcfdlrm.",
      "maxLength": 255
    },
    "observedEthnicity" : {
      "type": "integer"
    },
    "contactDetails": {
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/contact-details.json"
    },
    "address": {
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/address.json"
    },
    "occupation": {
      "type": "string",
      "maxLength": 54,
      "description": "The description of an occupation."
    },
    "defendantOccupationCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999,
      "description": "An occupation code."
    }
  },
  "required": [
    "surname",
    "address"
  ]
}