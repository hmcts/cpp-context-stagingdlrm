{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/hearing.json",
  "type": "object",
  "properties": {
    "courtHearingLocation": {
      "type": "string",
      "maxLength": 7,
      "minLength": 7
    },
    "courtRoomId": {
      "type": "integer"
    },
    "dateOfHearing": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/date"
    },
    "timeOfHearing": {
      "type": "string",
      "maxLength": 8,
      "minLength": 8,
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
    },
    "durationMinutes": {
      "type": "integer",
      "maximum": 99999
    },
    "weekCommencingDate": {
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/week-commencing-date.json"
    },
    "hearingType": {
      "type": "string",
      "maxLength": 10
    },
    "listedDefendants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/listed-defendant.json"
      }
    }
  },
  "required": [
    "courtHearingLocation",
    "hearingType",
    "listedDefendants",
    "durationMinutes"
  ]
}