{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/migrated-case-submission.json",
  "type": "object",
  "description": "Migrated Case File Submission",
  "properties": {
    "migratedCase": {
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/migrated-case.json"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/migrated-material.json"
      }
    },
    "metadata": {
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/migrated/json/schemas/migrated-material-metadata.json"
    },
    "submissionId": {
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "channel": {
      "type": "string",
      "$ref": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/pcf-definitions.json#/definitions/channel",
      "default": "DLRM_MIGRATION"
    },
    "azureLocation": {
      "type": "string"
    }
  },
  "required": [
    "migratedCase",
    "metadata",
    "submissionId",
    "azureLocation"
  ],
  "additionalProperties": false
}

