<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>stagingdlrm-domain</artifactId>
        <groupId>uk.gov.moj.cpp.stagingdlrm</groupId>
        <version>17.104.25-DLRMJ25-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>stagingdlrm-domain-value-schema</artifactId>

    <dependencies>
        <dependency>
            <groupId>uk.gov.moj.cpp.core.domain</groupId>
            <artifactId>common-core-domain</artifactId>
            <version>${coredomain.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- Test dependencies -->
        <!-- BC-13 parity: everit-org.json-schema + org.json are the catalogue-tier validation
             stack the DD-43191 Java 25 upgrade moves (org.json 20231013 -> 20251224). Pinned here
             so the numeric-literal and constraint-class tests exercise the same J17 stack as the
             framework's runtime catalogue validator. See docs/j25-parity-checklist.md. -->
        <dependency>
            <groupId>com.github.everit-org.json-schema</groupId>
            <artifactId>org.everit.json.schema</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- junit-jupiter-params pulls in junit-jupiter-api transitively; test-utils-core is
             deliberately not used here (it would drag Mockito/REST Assured/Groovy onto this
             module's test classpath for no reason - none of the tests in this module need them). -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>uk.gov.justice.schema</groupId>
                <artifactId>catalog-generation-plugin</artifactId>
                <executions>
                    <execution>
                        <id>schema-catalog-generation</id>
                        <configuration>
                            <generatorName>
                                uk.gov.justice.schema.catalog.generation.maven.MavenCatalogGeneratorFactory
                            </generatorName>
                            <parserName>
                                uk.gov.justice.schema.catalog.generation.io.parser.ListOfUriParser
                            </parserName>
                            <sourceDirectory>src/main/resources/json/schema</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-resources
                            </outputDirectory>
                            <includes>
                                <include>**/*.json</include>
                            </includes>
                            <generatorProperties implementation="uk.gov.justice.schema.catalog.generation.maven.CatalogGeneratorProperties">
                                <catalogName>${project.artifactId}</catalogName>
                                <jsonSchemaPath>json/schema/</jsonSchemaPath>
                            </generatorProperties>
                        </configuration>
                        <goals>
                            <goal>generate-schema-catalog</goal>
                        </goals>
                        <phase>generate-sources</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>