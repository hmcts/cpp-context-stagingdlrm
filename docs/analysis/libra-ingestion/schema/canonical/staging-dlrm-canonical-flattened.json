{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/canonical-flattened.json",
  "type": "object",
  "description": "Flattened view of the canonical stagingDLRM schema, rooted at migrated-case-submission.json. Generated by tools/schema-gen/flatten-canonical-schema.py from stagingdlrm-domain-value-schema/src/main/resources/json/schema. Not used at runtime — this exists only so the multi-file canonical schema can be diffed against a single-document one. Do not hand-edit.",
  "$ref": "#/definitions/migratedCaseSubmission",
  "definitions": {
    "alcoholRelatedOffence": {
      "type": "object",
      "properties": {
        "alcoholOrDrugLevelMethod": {
          "type": "string",
          "description": "Alcohol Level Method",
          "maxLength": 1
        },
        "alcoholOrDrugLevelAmount": {
          "type": "integer",
          "description": "Alcohol Level Amount",
          "maximum": 999
        }
      },
      "additionalProperties": false
    },
    "caseDetails": {
      "type": "object",
      "description": "Prosecution Case File Details",
      "properties": {
        "prosecutorCaseReference": {
          "type": "string",
          "maxLength": 36
        },
        "originatingOrganisation": {
          "type": "string",
          "description": "This is the oucode",
          "maxLength": 7,
          "minLength": 7
        },
        "prosecutor": {
          "$ref": "#/definitions/prosecutor"
        },
        "initiationCode": {
          "type": "string",
          "enum": [
            "O"
          ]
        },
        "cpsOrganisation": {
          "type": "string",
          "maxLength": 7,
          "minLength": 7
        },
        "caseMarkers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/caseMarkers"
          },
          "default": []
        },
        "dateReceived": {
          "$ref": "#/definitions/date",
          "description": "Date when case received from Magistrates court."
        },
        "dateOfSending": {
          "$ref": "#/definitions/date"
        },
        "dateOfCommittal": {
          "$ref": "#/definitions/date"
        },
        "receiptType": {
          "description": "The Receipt type",
          "type": "string",
          "maxLength": 40
        },
        "retrialIndicator": {
          "description": "The Re-trial indicator flag ",
          "type": "boolean"
        },
        "sendingCourt": {
          "type": "string",
          "description": "This is the organisation unit oucode of LIBRA case court. E.g B01LY00",
          "maxLength": 7,
          "minLength": 7
        },
        "receivingCourt": {
          "type": "string",
          "description": "This is the organisation unit oucode of XHIBIT case court. E.g C50EX00",
          "maxLength": 7,
          "minLength": 7
        }
      },
      "required": [
        "prosecutorCaseReference",
        "originatingOrganisation",
        "initiationCode",
        "prosecutor",
        "dateReceived",
        "retrialIndicator",
        "receiptType",
        "receivingCourt"
      ],
      "anyOf": [
        {
          "required": [
            "dateOfCommittal"
          ]
        },
        {
          "required": [
            "dateOfSending"
          ]
        }
      ],
      "additionalProperties": false
    },
    "caseMarkers": {
      "description": "Markers categorise the classes of a case or a person on a prosecution case",
      "type": "object",
      "properties": {
        "markerTypeCode": {
          "description": "The Code for the marker type",
          "type": "string",
          "maxLength": 3
        }
      },
      "required": [
        "markerTypeCode"
      ],
      "additionalProperties": false
    },
    "contactDetails": {
      "type": "object",
      "description": "Contact Details",
      "properties": {
        "work": {
          "description": "A business telephone number, including any exchange of location code, at which a person or organisation can be contacted in the UK by telephonic means.",
          "$ref": "#/definitions/phone"
        },
        "home": {
          "description": "A home telephone number, including any exchange of location code, at which a person or organisation can be contacted in the UK by telephonic means.",
          "$ref": "#/definitions/phone"
        },
        "mobile": {
          "description": "A mobile number, including any exchange of location code, at which a person or organisation can be contacted in the UK by telephonic means.",
          "$ref": "#/definitions/phone"
        },
        "primaryEmail": {
          "description": "The identification of the first e-mail address.",
          "$ref": "#/definitions/email"
        },
        "secondaryEmail": {
          "description": "The identification of the second e-mail address.",
          "$ref": "#/definitions/email"
        }
      },
      "additionalProperties": false
    },
    "individualAlias": {
      "type": "object",
      "description": "Individual alias",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title by which a person is addressed",
          "maxLength": 35
        },
        "firstName": {
          "description": "The person fore name",
          "type": "string"
        },
        "givenName2": {
          "type": "string",
          "description": "Middle name, e.g. Walter."
        },
        "givenName3": {
          "type": "string",
          "description": "Additional middle name, e.g. Percival."
        },
        "lastName": {
          "description": "The person last name",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "individual": {
      "type": "object",
      "description": "Individual Details",
      "properties": {
        "selfDefinedInformation": {
          "$ref": "#/definitions/selfDefinedInformation"
        },
        "personalInformation": {
          "$ref": "#/definitions/personalInformation"
        },
        "parentGuardianInformation": {
          "$ref": "#/definitions/parentGuardianInformation"
        },
        "custodyStatus": {
          "type": "string",
          "maxLength": 1
        },
        "custodyTimeLimit": {
          "$ref": "#/definitions/date",
          "description": "date of custody time limit"
        },
        "bailConditions": {
          "type": "string",
          "maxLength": 2500
        }
      },
      "required": [
        "personalInformation",
        "selfDefinedInformation"
      ]
    },
    "language": {
      "type": "string",
      "description": "Identifies the language to be used, values E or W (English or Welsh)",
      "enum": [
        "ENGLISH",
        "WELSH",
        "E",
        "W"
      ],
      "default": "E"
    },
    "caseAlreadyProcessedAndExistsInProgressionCommand": {
      "type": "object",
      "properties": {
        "migratedCaseSubmission": {
          "$ref": "#/definitions/migratedCaseSubmission"
        },
        "caseId": {
          "$ref": "#/definitions/uuid"
        }
      },
      "required": [
        "migratedCaseSubmission",
        "caseId"
      ]
    },
    "errorMigratedCaseSubmission": {
      "type": "object",
      "description": "Error Migrated Case Submission",
      "properties": {
        "payload": {
          "type": "string"
        },
        "submissionId": {
          "$ref": "#/definitions/uuid"
        },
        "errorMessage": {
          "type": "string"
        },
        "caseUrn": {
          "description": "The prosecuting authorities’ unique reference for a prosecution case",
          "type": "string"
        },
        "azureLocation": {
          "type": "string"
        }
      },
      "required": [
        "payload",
        "submissionId",
        "caseUrn",
        "azureLocation"
      ],
      "additionalProperties": false
    },
    "migratedCaseSubmissionProcessedOutput": {
      "type": "object",
      "properties": {
        "submissionId": {
          "$ref": "#/definitions/uuid"
        },
        "caseId": {
          "$ref": "#/definitions/uuid",
          "description": "The Id of the SJP case to initiate"
        },
        "caseUrn": {
          "description": "The prosecuting authorities’ unique reference for a prosecution case",
          "type": "string",
          "maxLength": 36
        },
        "processingIsSuccessful": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "submissionId",
        "caseUrn",
        "processingIsSuccessful"
      ]
    },
    "migratedCaseSubmission": {
      "type": "object",
      "description": "Migrated Case File Submission",
      "properties": {
        "migratedCase": {
          "$ref": "#/definitions/migratedCase"
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/migratedMaterial"
          }
        },
        "metadata": {
          "$ref": "#/definitions/migratedMaterialMetadata"
        },
        "submissionId": {
          "$ref": "#/definitions/uuid"
        },
        "channel": {
          "type": "string",
          "$ref": "#/definitions/channel",
          "default": "DLRM_MIGRATION"
        },
        "azureLocation": {
          "type": "string"
        }
      },
      "required": [
        "migratedCase",
        "metadata",
        "submissionId",
        "azureLocation"
      ],
      "additionalProperties": false
    },
    "migratedCase": {
      "type": "object",
      "description": "Migrated Case File Details",
      "properties": {
        "caseDetails": {
          "$ref": "#/definitions/caseDetails"
        },
        "hearings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/hearing"
          }
        },
        "defendants": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/defendant"
          }
        },
        "migrationSourceSystem": {
          "$ref": "#/definitions/migrationSourceSystem"
        }
      },
      "required": [
        "migrationSourceSystem",
        "defendants",
        "caseDetails"
      ],
      "additionalProperties": false
    },
    "defendant": {
      "type": "object",
      "description": "Defendant Details",
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid",
          "description": "It is being generated for CP platform before sending PCFDLRM"
        },
        "prosecutorDefendantId": {
          "type": "string",
          "description": "The unique identifier that comes legacy systems",
          "maxLength": 36
        },
        "asn": {
          "type": "string",
          "description": "Arrest / Summons number",
          "maxLength": 20
        },
        "documentationLanguage": {
          "type": "string",
          "description": "Language in which the defendant’s documents are written in legacy systems",
          "maxLength": 1
        },
        "hearingLanguage": {
          "type": "string",
          "description": "Language in which the defendant’s hearing is conducted in legacy systems",
          "maxLength": 1
        },
        "languageRequirement": {
          "type": "string",
          "description": "Notes about the defendant’s language needs, e.g. interpreter details",
          "maxLength": 150
        },
        "specificRequirements": {
          "type": "string",
          "description": "Notes about any help that the defendant may need when attending court – e.g. wheelchair access.",
          "maxLength": 150
        },
        "individual": {
          "$ref": "#/definitions/individual"
        },
        "offences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/offence"
          }
        },
        "emailAddress1": {
          "$ref": "#/definitions/email"
        },
        "emailAddress2": {
          "$ref": "#/definitions/email"
        },
        "organisationName": {
          "type": "string",
          "maxLength": 255
        },
        "pncIdentifier": {
          "type": "string",
          "maxLength": 13
        },
        "telephoneNumberBusiness": {
          "$ref": "#/definitions/phone"
        },
        "croNumber": {
          "type": "string",
          "maxLength": 12
        },
        "individualAliases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/individualAlias"
          }
        },
        "aliasForCorporate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "address": {
          "$ref": "#/definitions/address"
        }
      },
      "required": [
        "offences",
        "prosecutorDefendantId",
        "documentationLanguage",
        "hearingLanguage"
      ],
      "additionalProperties": false
    },
    "hearing": {
      "type": "object",
      "properties": {
        "courtHearingLocation": {
          "type": "string",
          "maxLength": 7,
          "minLength": 7
        },
        "courtRoomId": {
          "type": "integer"
        },
        "dateOfHearing": {
          "$ref": "#/definitions/date"
        },
        "timeOfHearing": {
          "type": "string",
          "maxLength": 8,
          "minLength": 8,
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$"
        },
        "durationMinutes": {
          "type": "integer",
          "maximum": 99999
        },
        "weekCommencingDate": {
          "$ref": "#/definitions/weekCommencingDate"
        },
        "hearingType": {
          "type": "string",
          "maxLength": 10
        },
        "listedDefendants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/listedDefendant"
          }
        }
      },
      "required": [
        "courtHearingLocation",
        "hearingType",
        "listedDefendants",
        "durationMinutes"
      ]
    },
    "listedDefendant": {
      "type": "object",
      "properties": {
        "prosecutorDefendantId": {
          "type": "string",
          "maxLength": 36
        },
        "listedOffences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 36
          }
        }
      },
      "required": [
        "prosecutorDefendantId",
        "listedOffences"
      ]
    },
    "migratedMaterialMetadata": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "numberOfMaterials": {
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "migratedMaterial": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "fileName": {
          "type": "string"
        },
        "fileType": {
          "type": "string"
        },
        "caseId": {
          "$ref": "#/definitions/uuid"
        },
        "azureLocation": {
          "type": "string"
        },
        "receivedDateTime": {
          "$ref": "#/definitions/dateTime"
        },
        "documentType": {
          "type": "integer"
        },
        "sectionCode": {
          "type": "string"
        },
        "defendantId": {
          "type": "string"
        },
        "documentCategory": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "azureLocation",
        "fileName",
        "fileType",
        "documentType"
      ],
      "additionalProperties": false
    },
    "offence": {
      "type": "object",
      "description": "Offences Details",
      "properties": {
        "prosecutorOffenceId": {
          "type": "string",
          "description": "it is unique identifier for the offence and comes from legacy systems",
          "maxLength": 36
        },
        "offenceCode": {
          "type": "string",
          "description": "Identifies the CJS code applicable to criminal offences as per the CJS Standard section 3.11",
          "maxLength": 8
        },
        "offenceSequenceNumber": {
          "type": "integer",
          "description": "Sequence number of the offence",
          "maximum": 999
        },
        "arrestDate": {
          "$ref": "#/definitions/date",
          "description": ""
        },
        "chargeDate": {
          "$ref": "#/definitions/date",
          "description": ""
        },
        "offenceDateCode": {
          "description": "The code for the offence date to be used within the offence wording, 1 = on or in, 2 = before, 3 = after, 4 = between, 5 = on or about and 6 = on or before",
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "offenceCommittedDate": {
          "$ref": "#/definitions/date",
          "description": "Date on which the offence is committed"
        },
        "offenceCommittedEndDate": {
          "$ref": "#/definitions/date",
          "description": "End date for period in which offence committed"
        },
        "offenceLocation": {
          "type": "string",
          "description": "Offence location",
          "maxLength": 80
        },
        "offenceWording": {
          "type": "string",
          "description": "Details of Information or Charge to be laid before the court",
          "maxLength": 2500
        },
        "offenceWordingWelsh": {
          "type": "string",
          "description": "Details of Information or Charge to be laid before the court in Welsh",
          "maxLength": 2500
        },
        "alcoholRelatedOffence": {
          "$ref": "#/definitions/alcoholRelatedOffence"
        },
        "plea": {
          "$ref": "#/definitions/plea"
        },
        "verdict": {
          "$ref": "#/definitions/verdict"
        },
        "allocationDecision": {
          "$ref": "#/definitions/allocationDecision"
        },
        "convictingCourtCode": {
          "type": "string",
          "description": "This is the organisation unit oucode. E.g B01BH00",
          "maxLength": 7,
          "minLength": 7
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "prosecutorOffenceId",
        "offenceCode",
        "offenceSequenceNumber",
        "offenceDateCode",
        "offenceCommittedDate",
        "offenceWording"
      ]
    },
    "weekCommencingDate": {
      "type": "object",
      "properties": {
        "startDate": {
          "description": "Week commencing start date.",
          "$ref": "#/definitions/datePattern"
        },
        "duration": {
          "description": "Duration of hearing. Number of weeks from the start date.",
          "$ref": "#/definitions/positiveInteger"
        }
      },
      "required": [
        "startDate"
      ],
      "additionalProperties": false
    },
    "migrationSourceSystem": {
      "type": "object",
      "description": "Migration Source System",
      "properties": {
        "migrationSourceSystemName": {
          "$ref": "#/definitions/migrationSourceSystemName"
        },
        "migrationSourceSystemCaseIdentifier": {
          "type": "string"
        }
      },
      "required": [
        "migrationSourceSystemName",
        "migrationSourceSystemCaseIdentifier"
      ],
      "additionalProperties": false
    },
    "migrationSourceSystemName": {
      "type": "string",
      "enum": [
        "LIBRA",
        "XHIBIT"
      ]
    },
    "parentGuardianInformation": {
      "type": "object",
      "description": "Parent Guardian Information",
      "oneOf": [
        {
          "properties": {
            "dateOfBirth": {
              "$ref": "#/definitions/date",
              "description": "The date when a person was born."
            },
            "gender": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9,
              "description": "Gender as stated by the parent guardian in Legacy systems"
            },
            "personalInformation": {
              "$ref": "#/definitions/personalInformation"
            },
            "selfDefinedEthnicity": {
              "type": "string",
              "maxLength": 2
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "organisationName": {
              "type": "string",
              "description": "Name of an organisation, e.g., Marks and Spencer.",
              "maxLength": 255
            },
            "companyTelephoneNumber": {
              "$ref": "#/definitions/phone"
            },
            "address": {
              "$ref": "#/definitions/address"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "address": {
      "type": "object",
      "description": "Address of the defendant",
      "properties": {
        "address1": {
          "type": "string",
          "description": "Address Line 1 for the defendant",
          "maxLength": 35
        },
        "address2": {
          "type": "string",
          "description": "Address Line 2 for the defendant",
          "maxLength": 35
        },
        "address3": {
          "type": "string",
          "description": "Address Line 3 for the defendant",
          "maxLength": 35
        },
        "address4": {
          "type": "string",
          "description": "Address Line 4 for the defendant",
          "maxLength": 35
        },
        "address5": {
          "type": "string",
          "description": "Address Line 5 for the defendant",
          "maxLength": 35
        },
        "postcode": {
          "$ref": "#/definitions/ukGovPostCode"
        }
      },
      "required": [
        "address1"
      ],
      "additionalProperties": false
    },
    "allocationDecision": {
      "description": "The allocation decision made regarding the jurisdiction required or elected for dealing with the offence in question",
      "type": "object",
      "properties": {
        "motReasonId": {
          "$ref": "#/definitions/uuid"
        },
        "allocationDecisionDate": {
          "$ref": "#/definitions/date"
        }
      },
      "required": [
        "motReasonId"
      ],
      "additionalProperties": false
    },
    "plea": {
      "description": "The plea entered at a hearing",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "pleaDate": {
          "$ref": "#/definitions/date"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "prosecutor": {
      "type": "object",
      "description": "Prosecutor Details",
      "properties": {
        "prosecutingAuthority": {
          "type": "string",
          "description": "Identifies the Prosecuting Organisation responsible for initiating the case. Valid CJS OU Code.",
          "maxLength": 7,
          "minLength": 7
        }
      },
      "required": [
        "prosecutingAuthority"
      ],
      "additionalProperties": false
    },
    "verdict": {
      "description": "The verdict i.e. the court decision",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/uuid"
        },
        "verdictDate": {
          "$ref": "#/definitions/date"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "personalInformation": {
      "type": "object",
      "description": "Personal Information",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title by which a person is addressed",
          "maxLength": 35
        },
        "forename": {
          "type": "string",
          "description": "The first given name of a person, e.g. John ",
          "maxLength": 255
        },
        "surname": {
          "type": "string",
          "description": "Surname or Family name, e.g. Brown.",
          "maxLength": 255
        },
        "middleName": {
          "type": "string",
          "description": "Middle name, e.g. Walter.",
          "maxLength": 255
        },
        "observedEthnicity": {
          "type": "integer"
        },
        "contactDetails": {
          "$ref": "#/definitions/contactDetails"
        },
        "address": {
          "$ref": "#/definitions/address"
        }
      },
      "required": [
        "surname"
      ]
    },
    "selfDefinedInformation": {
      "type": "object",
      "description": "Self defined information",
      "properties": {
        "nationality": {
          "type": "string",
          "description": "Country of origin as stated by the defendant, as per CJS Standards section 3.103",
          "maxLength": 3
        },
        "ethnicity": {
          "type": "string",
          "maxLength": 2
        },
        "dateOfBirth": {
          "$ref": "#/definitions/date",
          "description": "The date when a person was born."
        },
        "gender": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9,
          "description": "Gender as stated by the defendant in Legacy systems"
        }
      },
      "additionalProperties": false,
      "required": [
        "gender"
      ]
    },
    "phone": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^[\\+]?[0-9()\\-\\.\\s]+$"
    },
