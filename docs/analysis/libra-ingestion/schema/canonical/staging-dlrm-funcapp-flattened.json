{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://cpp.moj.gov.uk/stagingdlrm/json/schemas/canonical-flattened.json",
  "type": "object",
  "description": "Flattened view of the canonical stagingDLRM schema, rooted at stagingdlrm.case-submission.json. Generated by tools/schema-gen/flatten-canonical-schema.py from stagingdlrm-domain-value-schema/src/main/resources/json/schema. Not used at runtime — this exists only so the multi-file canonical schema can be diffed against a single-document one. Do not hand-edit.",
  "$ref": "#/definitions/stagingdlrm.caseSubmission",
  "definitions": {
    "caseDetails": {
      "type": "object",
      "description": "Prosecution Case File Details",
      "properties": {
        "prosecutorCaseReference": {
          "type": "string"
        },
        "originatingOrganisation": {
          "type": "string"
        },
        "prosecutor": {
          "$ref": "#/definitions/prosecutor"
        },
        "initiationCode": {
          "type": "string"
        },
        "dateReceived": {
          "type": "string",
          "description": "Date when case received from Magistrates court."
        },
        "receiptType": {
          "description": "The Receipt type",
          "type": "string"
        },
        "retrialIndicator": {
          "description": "The Re-trial indicator flag ",
          "type": "boolean"
        },
        "receivingCourt": {
          "type": "string",
          "description": "This is the organisation unit oucode of XHIBIT case court. E.g C50EX00"
        }
      },
      "required": [
        "prosecutorCaseReference",
        "originatingOrganisation",
        "initiationCode",
        "prosecutor",
        "dateReceived",
        "retrialIndicator",
        "receiptType",
        "receivingCourt"
      ],
      "additionalProperties": true
    },
    "migratedCase": {
      "type": "object",
      "description": "Migrated Case File Details",
      "properties": {
        "caseDetails": {
          "$ref": "#/definitions/caseDetails"
        }
      },
      "required": [
        "caseDetails"
      ],
      "additionalProperties": true
    },
    "migrationSourceSystem": {
      "type": "object",
      "description": "Migration Source System",
      "properties": {
        "migrationSourceSystemName": {
          "$ref": "#/definitions/migrationSourceSystemName"
        },
        "migrationSourceSystemCaseIdentifier": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "migrationSourceSystemName": {
      "type": "string",
      "enum": [
        "LIBRA",
        "XHIBIT"
      ]
    },
    "prosecutor": {
      "type": "object",
      "description": "Prosecutor Details",
      "properties": {
        "prosecutingAuthority": {
          "type": "string",
          "description": "Identifies the Prosecuting Organisation responsible for initiating the case. Valid CJS OU Code."
        }
      },
      "additionalProperties": true
    },
    "stagingdlrm.caseSubmission": {
      "type": "object",
      "description": "Migrated Case File Submission",
      "properties": {
        "migratedCase": {
          "$ref": "#/definitions/migratedCase"
        }
      },
      "required": [
        "migratedCase"
      ],
      "additionalProperties": false
    },
    "stagingdlrm.manifest": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": [
            {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string"
                },
                "fileType": {
                  "type": "string"
                },
                "documentType": {
                  "type": "integer"
                }
              },
              "required": [
                "fileName",
                "fileType",
                "documentType"
              ]
            },
            {
              "type": "object",
              "properties": {
                "fileName": {
                  "type": "string"
                },
                "fileType": {
                  "type": "string"
                },
                "documentType": {
                  "type": "integer"
                }
              },
              "required": [
                "fileName",
                "fileType",
                "documentType"
              ]
            }
          ]
        },
        "migrationSourceSystem": {
          "$ref": "#/definitions/migrationSourceSystem"
        }
      },
      "required": [
        "migrationSourceSystem"
      ],
      "additionalProperties": false
    }
  }
}
